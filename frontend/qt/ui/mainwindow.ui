         </property>
         <property name="alignment">
          <set>Qt::AlignCenter</set>
         </property>
         <property name="styleSheet">
          <string>font-size:18px; font-weight:bold;</string>
         </property>
        </widget>
       </item>

       <item>
        <widget class="QPushButton" name="btnChat">
         <property name="text">
          <string>💬 Chat</string>
         </property>
        </widget>
       </item>

       <item>
        <widget class="QPushButton" name="btnMaternity">
         <property name="text">
