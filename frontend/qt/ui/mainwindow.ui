          </size>
         </property>
        </spacer>
       </item>

      </layout>
     </widget>
    </item>

    <!-- Main Content -->
    <item>
     <widget class="QFrame" name="mainContent">
      <layout class="QVBoxLayout" name="mainLayout">

       <!-- Chat Display -->
       <item>
        <widget class="QTextEdit" name="chatOutput">
         <property name="readOnly">
          <bool>true</bool>
         </property>
         <property name="placeholderText">
          <string>AI responses will appear here...</string>
         </property>
        </widget>
       </item>

       <!-- Input Row -->
       <item>
